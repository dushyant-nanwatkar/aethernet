# ==============================================================================
# AetherNet Environment Configuration
# Configured for LM Studio LLM Provider
# ==============================================================================

# LLM Provider Configuration
# Options: "lmstudio", "ollama", "openai_compatible"
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_NAME=qwen/qwen3-14b

# Embedding Provider Configuration (Ollama / Local Embeddings)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_NAME=nomic-embed-text

# Infrastructure Services
REDIS_URL=redis://localhost:6379
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
KAFKA_BROKERS=localhost:9092

# Web & AI Orchestrator Ports
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
